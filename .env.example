# Telegram bot layer
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS= 
TELEGRAM_ALLOW_UNLISTED_USERS=

# AI provider selection: auto | gemini | groq | ollama
# auto tries only configured providers, in this order.
AI_PROVIDER=auto
AI_PROVIDER_ORDER=gemini,groq,ollama

# Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq provider
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama provider. OLLAMA_MODEL must match an installed model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=120

# AI execution safety
# AI_WORKSPACE_ROOT is the AI starting folder. Set AI_ALLOW_OUTSIDE_WORKSPACE=true for full-PC path access.
AI_WORKSPACE_ROOT=D:\Projects\riftshell
AI_ALLOW_OUTSIDE_WORKSPACE=false
AI_APPROVAL_TIMEOUT_MINUTES=30
AI_COMMAND_OUTPUT_LIMIT=3500
